# HardcoreAI backend configuration — LOCAL ONLY, gitignored.
# Fill in YOUR-PASSWORD with your Supabase database password before running.

# Use the pooler host (IPv4-friendly). The direct host db.*.supabase.co is
# IPv6-only — it fails with "failed to resolve host" on machines without IPv6.
DATABASE_URL=postgresql+psycopg://postgres.valyxxcifulxzlzoqiuq:Ych021o3UFOhtkpv@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# Direct connection (only works if your network has working IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:Ych021o3UFOhtkpv@db.valyxxcifulxzlzoqiuq.supabase.co:5432/postgres
SUPABASE_URL=https://valyxxcifulxzlzoqiuq.supabase.co
SUPABASE_ANON_KEY=sb_publishable_fs2EP0RZiXBgO4-x9PFXgQ_N8I4Djwv
SUPABASE_SERVICE_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=62018
# AI agent LLM providers (see .env.example for details).
LLAMACPP_URL=http://127.0.0.1:62021/v1/chat/completions
LLAMACPP_MODEL=prism-ml/Bonsai-8B-gguf:Q1_0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_HTTP_REFERER=http://127.0.0.1:62017
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Web search via self-hosted SearXNG (used by RAG scraping and the agent's search_and_ingest_web tool).
# Run: docker compose up -d  (from the project root) to start SearXNG on this port.
SEARXNG_URL=http://localhost:8080
