# Public browser configuration. Never put service-role or provider keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_OAUTH_PROVIDER=github

# Register this exact URL in Supabase Auth's redirect allowlist. The packaged
# application can override it with its stable localhost callback/deep link.
VITE_SUPABASE_REDIRECT_URL=http://127.0.0.1:32018
VITE_BACKEND_URL=http://127.0.0.1:62018
