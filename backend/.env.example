# Web search (agent's search_and_ingest_web tool). Runs in-process — no server.
# Optional: set a Brave Search API key for a licensed, commercial-safe backend
# (https://brave.com/search/api/). If left blank, search falls back to the
# key-less DuckDuckGo backend, which is fine for dev/MVP but scrapes DuckDuckGo
# (against its ToS) and is rate-limited — set this before a commercial launch.
BRAVE_API_KEY=

PUBLIC_API_BASE=
PUBLIC_EMULATOR_BASE=
