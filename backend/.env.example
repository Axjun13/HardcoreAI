# HardcoreAI backend configuration

DATABASE_URL=

# Public Supabase values used only to verify user access tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=62018

LLAMACPP_URL=
LLAMACPP_MODEL=
OLLAMA_URL=
OLLAMA_MODEL=

# Public URL only. Paid provider keys remain in the private proxy project.
HARDCOREAI_PROXY_URL=https://hardcoreai-proxy-server.vercel.app

# Optional model-context overrides, in tokens. Provider-specific values take
# precedence over AGENT_CONTEXT_WINDOW when using a custom/private model.
AGENT_CONTEXT_WINDOW=
CLOUD_CONTEXT_WINDOW=131072
LLAMACPP_CONTEXT_WINDOW=
OLLAMA_CONTEXT_WINDOW=

# Local agent safety limits (the private gateway applies additional limits).
AGENT_MAX_STEPS=24
AGENT_MAX_RETRIES=4
AGENT_MAX_DURATION_SECONDS=600
AGENT_LLM_TIMEOUT_SECONDS=150

PUBLIC_API_BASE=
PUBLIC_EMULATOR_BASE=
