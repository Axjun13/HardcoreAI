# HardcoreAI backend configuration

DATABASE_URL=

# Alternative Supabase connection
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=62018

LLAMACPP_URL=
LLAMACPP_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=

# DeepSeek uses the OpenRouter key above when OPENROUTER_MODEL is a
# deepseek/* route. These direct-provider settings are optional.
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v3.2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional; ownership/configuration may be delegated independently.
SARVAM_API_KEY=
SARVAM_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_MODEL=sarvam-30b

# Optional model-context overrides, in tokens. Provider-specific values take
# precedence over AGENT_CONTEXT_WINDOW when using a custom/private model.
AGENT_CONTEXT_WINDOW=
GEMINI_CONTEXT_WINDOW=
DEEPSEEK_CONTEXT_WINDOW=
SARVAM_CONTEXT_WINDOW=
OPENROUTER_CONTEXT_WINDOW=
LLAMACPP_CONTEXT_WINDOW=
OLLAMA_CONTEXT_WINDOW=

# Web search (agent tools and Research component discovery). Runs in-process — no server.
# Optional: set a Brave Search API key for a licensed, commercial-safe backend
# (https://brave.com/search/api/). If left blank, search falls back to the
# key-less DuckDuckGo backend, which is fine for dev/MVP but scrapes DuckDuckGo
# (against its ToS) and is rate-limited — set this before a commercial launch.
BRAVE_API_KEY=

PUBLIC_API_BASE=
PUBLIC_EMULATOR_BASE=
